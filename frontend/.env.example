# Copy to frontend/.env. Everything is optional.
# VITE_API_BASE=https://your-space.hf.space      # empty = same origin (dev proxy / vercel rewrite)
# VITE_GOOGLE_MAPS_KEY=                          # Maps Embed API (Street View), restrict by HTTP referrer
# VITE_MAPILLARY_TOKEN=                          # Mapillary client token (street-level walk)
# VITE_GOOGLE_MAPS_3D_KEY=                       # Maps JavaScript API with 3D (maps3d) + Places (New) + Routes: /map3d page
