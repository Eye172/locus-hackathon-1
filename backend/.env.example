# Copy to backend/.env. All keys are optional: without them the matching feature is shown as disabled.
# LLM (AI inspector for every photo, description with citations, compare + chat). Gemini has a free tier without a card.
GEMINI_API_KEY=
# more Gemini keys from other Google Cloud projects (each project has its own daily free quota; a project with
# billing has none). A server-side key restricted to "Generative Language API" - never the public Maps key
GEMINI_API_KEY_2=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=auto        # auto | claude | gemini | none
# GEMINI_MODEL=gemini-3.5-flash-lite
# CLAUDE_MODEL=claude-opus-5

# Extra photo sources
SERPER_API_KEY=            # Google Images by category (serper.dev, 2500 free queries)
SCRAPECREATORS_API_KEY=    # Instagram / TikTok posts and TikTok search (scrapecreators.com)
YOUTUBE_API_KEY=           # YouTube Data API v3: videos about the university from any channel
MAPILLARY_TOKEN=
FLICKR_API_KEY=
# Places API (New): photos of the university pin and of its dorms, library, sports complex, canteen pins
GOOGLE_MAPS_API_KEY=

# Tuning
# PIPELINE_BUDGET_S=25
# INSPECT_MODEL=gemini-3.5-flash-lite
# INSPECT_MAX_PHOTOS=112
# CORS_ORIGINS=["*"]
# dev: send every page from :8000 to the Vite dev server so there is one site; leave empty in production
FRONTEND_ORIGIN=http://localhost:5173
# optional, only for scripts/higgsfield_cutscene.py (spends credits; never used by the pipeline)
HIGGSFIELD_API_KEY=
