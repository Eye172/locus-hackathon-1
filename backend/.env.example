# Copy to backend/.env. All keys are optional: without them the matching feature is shown as disabled.
# LLM (AI inspector for every photo, description with citations, compare + chat). Gemini has a free tier without a card.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=auto        # auto | claude | gemini | none
# GEMINI_MODEL=gemini-3.5-flash-lite
# CLAUDE_MODEL=claude-opus-5

# Extra photo sources
MAPILLARY_TOKEN=
FLICKR_API_KEY=
GOOGLE_MAPS_API_KEY=

# Tuning
# PIPELINE_BUDGET_S=25
# INSPECT_MODEL=gemini-3.5-flash-lite
# INSPECT_MAX_PHOTOS=112
# CORS_ORIGINS=["*"]
# dev: send every page from :8000 to the Vite dev server so there is one site; leave empty in production
FRONTEND_ORIGIN=http://localhost:5173
# optional, only for scripts/higgsfield_cutscene.py (spends credits; never used by the pipeline)
HIGGSFIELD_API_KEY=
